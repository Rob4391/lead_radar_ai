DATABASE_URL=postgres://lead_radar:changeme@localhost:5432/lead_radar

# Required to verify Clerk session tokens sent by the frontend (Bearer auth on all /leads routes)
CLERK_SECRET_KEY=sk_test_replace_me

# Optional legacy admin key, bypasses Clerk auth for internal scripts/CI (x-api-key header)
ADMIN_API_KEY=changeme

# Required for the lead-collection job to query Google Places
GOOGLE_PLACES_API_KEY=REPLACE_ME

# Redis connection used by the Bull job queue (defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379
