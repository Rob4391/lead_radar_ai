generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id       Int      @id @default(autoincrement())
  placeId  String?  @unique
  name     String?
  phone    String?
  website  String?
  emails   String[]
  urls     String[]
  titles   String[]
  city     String?
  category String?
  reviewCount Int?
  instagram String?
  facebook String?
  score    Float?
  createdAt DateTime @default(now())
}
