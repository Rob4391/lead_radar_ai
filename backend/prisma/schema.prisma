generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id       Int      @id @default(autoincrement())
  placeId  String?  @unique
  name     String?
  phone    String?
  website  String?
  emails   String[]
  urls     String[]
  titles   String[]
  city     String?
  category String?
  reviewCount Int?
  instagram String?
  facebook String?
  score    Float?
  createdAt DateTime @default(now())

  coldEmail        String?
  linkedinMessage  String?
  whatsappMessage  String?
  outreachGeneratedAt DateTime?

  websiteAgeYears Float?
  isOldWebsite    Boolean?
  mobileFriendly  Boolean?
  isSlowLoad      Boolean?
  hasBrokenPages  Boolean?
  auditedAt       DateTime?
}

enum Plan {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  plan      Plan?
  status    SubscriptionStatus @default(EXPIRED)

  periodStart         DateTime?
  currentPeriodEnd    DateTime?
  searchesThisPeriod  Int @default(0)

  lastRazorpayOrderId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
